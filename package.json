{
  "name": "madeira-timetables",
  "version": "0.1.0",
  "description": "Offline-first PWA with Madeira bus timetables",
  "scripts": {
    "scrape": "node scripts/scrape.mjs",
    "parse": "node scripts/parse.mjs",
    "fetch:osm": "node scripts/fetch-osm-stops.mjs",
    "fetch:gtfs": "node scripts/fetch-gtfs.mjs",
    "fetch:routes": "node scripts/fetch-routes.mjs",
    "fetch:pois": "node scripts/fetch-osm-pois.mjs",
    "enrich:stops": "node scripts/enrich-stops.mjs",
    "resolve:terminals": "node scripts/resolve-terminals.mjs",
    "fetch:via-routes": "node scripts/fetch-via-routes.mjs",
    "build:data": "node scripts/build-data.mjs",
    "verify": "node scripts/verify.mjs",
    "audit": "node scripts/audit-schedules.mjs",
    "audit:stops": "node scripts/audit-stops.mjs",
    "audit:split-stops": "node scripts/audit-split-stops.mjs",
    "match:corridor": "node scripts/match-corridor-stops.mjs",
    "audit:via": "node scripts/audit-via.mjs",
    "dev": "vite",
    "build": "npm run build:data && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --pool=threads",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name madeira-timetables"
  },
  "type": "module",
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pbf": "^4.0.2",
    "pdfjs-dist": "^4.10.38",
    "puppeteer-core": "^25.14.0",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "dependencies": {
    "leaflet": "^1.9.4",
    "pmtiles": "^3.2.1",
    "protomaps-leaflet": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
